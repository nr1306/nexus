{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/inventory/ReserveInventory.v1.schema.json",
  "title": "ReserveInventory payload (command, topic inventory.commands)",
  "description": "Reserve every item for the order, all or nothing. Replies: InventoryReserved or InventoryRejected.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sku", "quantity"], "additionalProperties": false, "properties": { "sku": { "type": "string", "minLength": 1 }, "quantity": { "type": "integer", "minimum": 1 } } } }
  }
}
