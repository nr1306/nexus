{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/order/OrderCreated.v1.schema.json",
  "title": "OrderCreated payload (event, topic order.events)",
  "description": "An order was accepted and its saga started.",
  "type": "object",
  "required": [
    "customerId",
    "items",
    "totalCents",
    "currency"
  ],
  "additionalProperties": false,
  "properties": {
    "customerId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "quantity",
          "unitPriceCents"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "totalCents": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
